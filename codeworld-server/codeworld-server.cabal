Name:                codeworld-server
Version:             0.1
Synopsis:            Web server for CodeWorld
License-file:        LICENSE
Author:              The CodeWorld Authors
Maintainer:          Chris Smith <cdsmith@gmail.com>
Copyright:           (c) 2020, The CodeWorld Authors
Build-type:          Simple
Cabal-version:       >=1.2

Description:
  The web server for the CodeWorld programming environment.


Executable codeworld-server
  Hs-source-dirs: src
  Main-is: Main.hs
  Other-modules: Util, Config

  Build-depends:
    aeson,
    base,
    bytestring,
    codeworld-compiler,
    containers,
    directory,
    extra,
    filepath,
    lifted-base,
    mtl,
    ormolu >= 0.1,
    regex-tdfa,
    SafeSemaphore,
    snap-core,
    snap-server,
    temporary,
    text,
    yaml

  Ghc-options: -threaded
               -Wall
               -fno-warn-unused-do-bind
               -funbox-strict-fields
